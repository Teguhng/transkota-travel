<div class="space-y-8">
  <div class="border-b-bar border-rule pb-4">
    <div class="inline-block px-2.5 py-0.5 mb-1 border-hair border-rule text-xs font-bold uppercase text-accent bg-paper-3">
      Audit & Pelayanan
    </div>
    <h1 class="text-xl sm:text-2xl font-extrabold text-ink uppercase tracking-tight">Pengguna & Evaluasi Keluhan</h1>
    <p class="text-xs text-muted mt-1">Audit akun seluruh pengguna sistem dan berikan respons resmi terhadap keluhan layanan penumpang.</p>
  </div>

  <!-- Bagian 1: Pusat Tanggapan Keluhan Pelanggan -->
  <div class="transit-box p-6 space-y-4">
    <div class="flex items-center justify-between border-b-bar border-rule pb-3">
      <h2 class="text-xs font-extrabold uppercase tracking-wider text-ink">Daftar Pengaduan Layanan (<%= complaints.length %>)</h2>
      <span class="text-xs text-muted uppercase font-bold">Respons Keluhan Penumpang</span>
    </div>

    <% if (complaints.length === 0) { %>
      <div class="text-center py-12 text-muted text-xs font-bold uppercase">
        Belum ada pengaduan pelanggan yang tercatat.
      </div>
    <% } else { %>
      <div class="space-y-4">
        <% complaints.forEach(c => { %>
          <div class="border-bar border-rule p-5 space-y-3 bg-paper-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b-hair border-rule pb-2">
              <div>
                <span class="font-extrabold text-xs text-ink uppercase"><%= c.judul %></span>
                <span class="text-[11px] text-muted block">
                  Dari: <strong><%= c.nama_pelapor || c.nama_member %></strong> (<%= c.email_pelapor || c.email_member || c.telepon_member || 'Pelanggan' %>) &bull; <%= new Date(c.dibuat_pada || c.created_at).toLocaleString('id-ID') %>
                  <% if (c.kode_booking) { %> &bull; Tiket: <strong class="font-mono text-accent"><%= c.kode_booking %></strong><% } %>
                </span>
              </div>
              <span class="inline-block px-2 py-0.5 border-hair border-rule text-[10px] font-bold uppercase
                <%= c.status === 'selesai' ? 'text-accent bg-paper' : '' %>
                <%= c.status === 'diproses' ? 'bg-ink text-paper' : '' %>
                <%= c.status === 'baru' || c.status === 'diajukan' ? 'bg-accent-2 text-ink' : '' %>">
                <%= c.status %>
              </span>
            </div>

            <p class="text-xs text-ink bg-paper p-3 border-hair border-rule"><%= c.isi %></p>

            <% if (c.tanggapan) { %>
              <div class="text-xs p-3 bg-paper border-bar border-accent">
                <span class="font-bold text-accent uppercase block mb-0.5">Tanggapan Resmi:</span>
                <p class="text-ink"><%= c.tanggapan %></p>
              </div>
            <% } %>

            <!-- Formulir Respons Admin -->
            <form action="/admin/keluhan/<%= c.id %>/tanggapi" method="POST" class="pt-2 flex flex-col sm:flex-row gap-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="text" name="tanggapan" required placeholder="Tulis tanggapan atau solusi untuk keluhan ini..." class="flex-grow border-bar border-rule bg-paper px-3 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent">
              
              <select name="status" class="border-bar border-rule bg-paper px-3 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent">
                <option value="selesai">Status: Selesai</option>
                <option value="diproses">Status: Diproses</option>
              </select>

              <button type="submit" class="transit-btn transit-btn-cobalt py-2 px-4 text-xs font-bold">
                Kirim Respons
              </button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- Bagian 2: Daftar Akun Pengguna Terdaftar -->
  <div class="transit-box p-6 space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b-bar border-rule pb-3">
      <h2 class="text-xs font-extrabold uppercase tracking-wider text-ink">Daftar Akun Pengguna Terdaftar (<%= users.length %>)</h2>

      <!-- Filter Role Pengguna: Wayfind Square Cells -->
      <div class="flex border-bar border-rule bg-paper text-xs font-bold uppercase">
        <a href="/admin/users-keluhan" class="px-3 py-1.5 border-r-hair border-rule <%= !roleFilter ? 'bg-ink text-paper' : 'text-ink hover:bg-paper-2' %>">Semua</a>
        <a href="/admin/users-keluhan?role=admin" class="px-3 py-1.5 border-r-hair border-rule <%= roleFilter === 'admin' ? 'bg-ink text-paper' : 'text-ink hover:bg-paper-2' %>">Admin</a>
        <a href="/admin/users-keluhan?role=operator" class="px-3 py-1.5 border-r-hair border-rule <%= roleFilter === 'operator' ? 'bg-ink text-paper' : 'text-ink hover:bg-paper-2' %>">Operator</a>
        <a href="/admin/users-keluhan?role=member" class="px-3 py-1.5 <%= roleFilter === 'member' ? 'bg-ink text-paper' : 'text-ink hover:bg-paper-2' %>">Member</a>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y-bar divide-rule text-xs">
        <thead class="bg-paper-3 font-bold text-ink uppercase">
          <tr>
            <th class="px-4 py-3 text-left">ID</th>
            <th class="px-4 py-3 text-left">Nama Lengkap</th>
            <th class="px-4 py-3 text-left">Username</th>
            <th class="px-4 py-3 text-left">Kontak</th>
            <th class="px-4 py-3 text-left">Role</th>
            <th class="px-4 py-3 text-center">Status Sandi</th>
          </tr>
        </thead>
        <tbody class="divide-y-hair divide-rule bg-paper">
          <% users.forEach(u => { %>
            <tr class="hover:bg-paper-2">
              <td class="px-4 py-3 font-mono font-bold text-muted">#<%= u.id %></td>
              <td class="px-4 py-3 font-bold text-ink uppercase"><%= u.nama %></td>
              <td class="px-4 py-3 font-mono text-muted"><%= u.username %></td>
              <td class="px-4 py-3 text-muted">
                <div><%= u.email || '-' %></div>
                <div class="font-mono"><%= u.telepon || '-' %></div>
              </td>
              <td class="px-4 py-3">
                <span class="inline-block px-2 py-0.5 border-hair border-rule text-[10px] font-bold uppercase
                  <%= u.role === 'admin' ? 'bg-ink text-paper' : '' %>
                  <%= u.role === 'operator' ? 'bg-paper-3 text-accent' : '' %>
                  <%= u.role === 'member' ? 'bg-paper text-ink' : '' %>">
                  <%= u.role %>
                </span>
              </td>
              <td class="px-4 py-3 text-center">
                <% if (u.wajib_reset_password === 1) { %>
                  <span class="inline-block px-2 py-0.5 border-bar border-ink bg-accent-2 text-ink text-[10px] font-bold uppercase">
                    Perlu Aktivasi
                  </span>
                <% } else { %>
                  <span class="inline-block px-2 py-0.5 border-hair border-rule text-ink text-[10px] font-bold uppercase">
                    Aktif
                  </span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
