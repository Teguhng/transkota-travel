<div class="space-y-8">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b-bar border-rule pb-4">
    <div>
      <div class="inline-block px-2.5 py-0.5 mb-1 border-hair border-rule text-xs font-bold uppercase text-accent bg-paper-3">
        Direksi & Manajemen
      </div>
      <h1 class="text-xl sm:text-2xl font-extrabold text-ink uppercase tracking-tight">Statistik & Kinerja Bisnis</h1>
      <p class="text-xs text-muted mt-1">Ikhtisar metrik omzet penjualan tiket, load factor rute, dan armada operasional.</p>
    </div>
    <div class="flex items-center gap-2">
      <a href="/admin/master" class="transit-btn transit-btn-cobalt py-2 px-4 text-xs font-bold">
        Data Master Sistem
      </a>
    </div>
  </div>

  <!-- KPI Metrik Utama: Wayfind Transit Boxes -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="transit-box p-6">
      <span class="text-xs font-bold uppercase text-muted block border-b-hair border-rule pb-2">Total Pendapatan</span>
      <div class="mt-3 text-2xl font-extrabold text-ink num">
        <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(stats.totalRevenue) %>
      </div>
      <span class="text-[11px] text-muted mt-1 block">Transaksi lunas terverifikasi</span>
    </div>

    <div class="transit-box p-6">
      <span class="text-xs font-bold uppercase text-muted block border-b-hair border-rule pb-2">Pesanan Hari Ini</span>
      <div class="mt-3 text-3xl font-extrabold text-ink num">
        <%= stats.todayBookings %>
      </div>
      <span class="text-[11px] text-muted mt-1 block">Aktivitas 24 jam terakhir</span>
    </div>

    <div class="transit-box p-6">
      <span class="text-xs font-bold uppercase text-muted block border-b-hair border-rule pb-2">Jadwal Keberangkatan</span>
      <div class="mt-3 text-3xl font-extrabold text-ink num">
        <%= stats.activeSchedulesCount %>
      </div>
      <span class="text-[11px] text-muted mt-1 block">Armada aktif terjadwal</span>
    </div>

    <div class="transit-box p-6">
      <span class="text-xs font-bold uppercase text-muted block border-b-hair border-rule pb-2">Keluhan Menunggu</span>
      <div class="mt-3 text-3xl font-extrabold num <%= stats.pendingComplaintsCount > 0 ? 'text-accent' : 'text-ink' %>">
        <%= stats.pendingComplaintsCount %>
      </div>
      <a href="/admin/users-keluhan" class="text-xs font-bold text-accent uppercase hover:underline mt-1 block">Tanggapi keluhan</a>
    </div>
  </div>

  <!-- Rute Terpopuler & Pesanan Terkini -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Rute Terpopuler -->
    <div class="transit-box p-6">
      <h2 class="text-xs font-extrabold uppercase tracking-wider text-ink border-b-bar border-rule pb-2 mb-4">Rute Paling Diminati</h2>
      <% if (!stats.topRoutes || stats.topRoutes.length === 0) { %>
        <p class="text-xs text-muted py-6 text-center font-bold uppercase">Belum ada data perjalanan terakumulasi.</p>
      <% } else { %>
        <div class="space-y-3">
          <% stats.topRoutes.forEach(r => { %>
            <div class="flex items-center justify-between p-3 border-bar border-rule bg-paper-3">
              <div>
                <span class="font-extrabold text-xs text-ink uppercase"><%= r.kota_asal %> &rarr; <%= r.kota_tujuan %></span>
                <span class="text-[11px] text-muted block"><%= r.total_booking %> tiket terbit</span>
              </div>
              <span class="font-mono font-extrabold text-xs text-ink num">
                <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(r.total_nominal) %>
              </span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- Transaksi Terkini -->
    <div class="transit-box p-6">
      <h2 class="text-xs font-extrabold uppercase tracking-wider text-ink border-b-bar border-rule pb-2 mb-4">Transaksi Terakhir</h2>
      <% if (!stats.recentBookings || stats.recentBookings.length === 0) { %>
        <p class="text-xs text-muted py-6 text-center font-bold uppercase">Belum ada transaksi tiket.</p>
      <% } else { %>
        <div class="space-y-3">
          <% stats.recentBookings.forEach(b => { %>
            <div class="flex items-center justify-between text-xs border-b-hair border-rule pb-2.5 last:border-0 last:pb-0">
              <div>
                <span class="font-mono font-bold text-accent"><%= b.kode_booking %></span>
                <span class="text-muted block"><%= b.nama_pemesan %> &bull; <%= b.kota_asal %> &rarr; <%= b.kota_tujuan %></span>
              </div>
              <div class="text-right">
                <span class="font-extrabold text-ink block num">
                  <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(b.total_harga) %>
                </span>
                <span class="text-[10px] uppercase font-bold text-muted"><%= b.status %></span>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</div>
