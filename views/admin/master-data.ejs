<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b-bar border-rule pb-4">
    <div>
      <div class="inline-block px-2.5 py-0.5 mb-1 border-hair border-rule text-xs font-bold uppercase text-accent bg-paper-3">
        Konfigurasi Sistem
      </div>
      <h1 class="text-xl sm:text-2xl font-extrabold text-ink uppercase tracking-tight">Manajemen Data Master</h1>
      <p class="text-xs text-muted mt-1">Konfigurasi rute perjalanan, armada minibus 5-kursi, jadwal keberangkatan, dan terminal kota.</p>
    </div>

    <!-- Navigasi Tab: Wayfind Square Cells -->
    <div class="flex flex-wrap border-bar border-rule bg-paper text-xs font-bold uppercase">
      <a href="/admin/master?tab=jadwal" class="px-3.5 py-2 border-r-hair border-rule <%= tab === 'jadwal' ? 'bg-ink text-paper' : 'text-ink hover:bg-paper-2' %>">
        Jadwal
      </a>
      <a href="/admin/master?tab=rute" class="px-3.5 py-2 border-r-hair border-rule <%= tab === 'rute' ? 'bg-ink text-paper' : 'text-ink hover:bg-paper-2' %>">
        Rute
      </a>
      <a href="/admin/master?tab=kendaraan" class="px-3.5 py-2 border-r-hair border-rule <%= tab === 'kendaraan' ? 'bg-ink text-paper' : 'text-ink hover:bg-paper-2' %>">
        Armada
      </a>
      <a href="/admin/master?tab=kota" class="px-3.5 py-2 <%= tab === 'kota' ? 'bg-ink text-paper' : 'text-ink hover:bg-paper-2' %>">
        Kota
      </a>
    </div>
  </div>

  <!-- Konten Tab Sesuai Pilihan -->
  <% if (tab === 'jadwal') { %>
    <!-- Tab Jadwal -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Formulir Terbitkan Jadwal Baru -->
      <div class="lg:col-span-4">
        <div class="transit-box p-6">
          <h2 class="text-xs font-extrabold uppercase tracking-wider text-ink border-b-bar border-rule pb-2 mb-4">Terbitkan Jadwal Baru</h2>
          <form action="/admin/master/jadwal" method="POST" class="space-y-4">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div>
              <label for="id_rute" class="block text-xs font-bold uppercase text-ink mb-1.5">Rute Perjalanan *</label>
              <select id="id_rute" name="id_rute" required class="w-full border-bar border-rule bg-paper px-3 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent">
                <option value="">Pilih Rute...</option>
                <% routes.forEach(r => { %>
                  <option value="<%= r.id %>"><%= r.kota_asal %> &rarr; <%= r.kota_tujuan %></option>
                <% }) %>
              </select>
            </div>

            <div>
              <label for="id_kendaraan" class="block text-xs font-bold uppercase text-ink mb-1.5">Armada Minibus *</label>
              <select id="id_kendaraan" name="id_kendaraan" required class="w-full border-bar border-rule bg-paper px-3 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent">
                <option value="">Pilih Armada...</option>
                <% vehicles.forEach(v => { %>
                  <option value="<%= v.id %>"><%= v.jenis %> (<%= v.nomor_polisi %>)</option>
                <% }) %>
              </select>
            </div>

            <div>
              <label for="berangkat_pada" class="block text-xs font-bold uppercase text-ink mb-1.5">Waktu Keberangkatan *</label>
              <input type="datetime-local" id="berangkat_pada" name="berangkat_pada" required class="w-full border-bar border-rule bg-paper px-3 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent">
            </div>

            <div>
              <label for="tiba_pada" class="block text-xs font-bold uppercase text-ink mb-1.5">Estimasi Tiba (Opsional)</label>
              <input type="datetime-local" id="tiba_pada" name="tiba_pada" class="w-full border-bar border-rule bg-paper px-3 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent">
            </div>

            <div>
              <label for="harga" class="block text-xs font-bold uppercase text-ink mb-1.5">Tarif per Kursi (IDR) *</label>
              <input type="number" id="harga" name="harga" min="10000" step="5000" required placeholder="Contoh: 150000" class="w-full border-bar border-rule bg-paper px-3 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent">
            </div>

            <button type="submit" class="w-full transit-btn transit-btn-cobalt py-2.5 text-xs font-bold">
              Terbitkan Jadwal (5 Kursi)
            </button>
          </form>
        </div>
      </div>

      <!-- Tabel Daftar Seluruh Jadwal -->
      <div class="lg:col-span-8">
        <div class="transit-box overflow-hidden">
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y-bar divide-rule text-xs">
              <thead class="bg-paper-3 font-bold text-ink uppercase">
                <tr>
                  <th class="px-4 py-3 text-left">ID</th>
                  <th class="px-4 py-3 text-left">Rute Perjalanan</th>
                  <th class="px-4 py-3 text-left">Armada</th>
                  <th class="px-4 py-3 text-left">Keberangkatan</th>
                  <th class="px-4 py-3 text-right">Tarif</th>
                  <th class="px-4 py-3 text-center">Kursi</th>
                </tr>
              </thead>
              <tbody class="divide-y-hair divide-rule bg-paper">
                <% schedules.forEach(s => { %>
                  <tr class="hover:bg-paper-2">
                    <td class="px-4 py-3 font-mono font-bold text-muted">#<%= s.id %></td>
                    <td class="px-4 py-3 font-bold text-ink uppercase"><%= s.kota_asal %> &rarr; <%= s.kota_tujuan %></td>
                    <td class="px-4 py-3 text-muted"><%= s.kendaraan_jenis || 'Minibus' %> (<%= s.nomor_polisi %>)</td>
                    <td class="px-4 py-3 text-ink">
                      <%= new Date(s.berangkat_pada).toLocaleString('id-ID') %>
                    </td>
                    <td class="px-4 py-3 text-right font-extrabold text-ink num">
                      <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(s.harga) %>
                    </td>
                    <td class="px-4 py-3 text-center">
                      <span class="inline-block px-2 py-0.5 border-hair border-rule text-[10px] font-bold uppercase <%= s.kursi_tersedia > 0 ? 'text-accent' : 'text-muted' %>">
                        <%= s.kursi_tersedia %> / 5
                      </span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

  <% } else if (tab === 'rute') { %>
    <!-- Tab Rute -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-4">
        <div class="transit-box p-6">
          <h2 class="text-xs font-extrabold uppercase tracking-wider text-ink border-b-bar border-rule pb-2 mb-4">Tambah Rute Antarkota</h2>
          <form action="/admin/master/rute" method="POST" class="space-y-4">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div>
              <label for="id_kota_asal" class="block text-xs font-bold uppercase text-ink mb-1.5">Kota Asal *</label>
              <select id="id_kota_asal" name="id_kota_asal" required class="w-full border-bar border-rule bg-paper px-3 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent">
                <% cities.forEach(c => { %><option value="<%= c.id %>"><%= c.nama %></option><% }) %>
              </select>
            </div>

            <div>
              <label for="id_kota_tujuan" class="block text-xs font-bold uppercase text-ink mb-1.5">Kota Tujuan *</label>
              <select id="id_kota_tujuan" name="id_kota_tujuan" required class="w-full border-bar border-rule bg-paper px-3 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent">
                <% cities.forEach(c => { %><option value="<%= c.id %>"><%= c.nama %></option><% }) %>
              </select>
            </div>

            <button type="submit" class="w-full transit-btn transit-btn-cobalt py-2.5 text-xs font-bold">
              Simpan Rute Baru
            </button>
          </form>
        </div>
      </div>

      <div class="lg:col-span-8">
        <div class="transit-box overflow-hidden">
          <table class="min-w-full divide-y-bar divide-rule text-xs">
            <thead class="bg-paper-3 font-bold text-ink uppercase">
              <tr>
                <th class="px-6 py-3 text-left">ID</th>
                <th class="px-6 py-3 text-left">Kota Asal</th>
                <th class="px-6 py-3 text-left">Kota Tujuan</th>
              </tr>
            </thead>
            <tbody class="divide-y-hair divide-rule bg-paper">
              <% routes.forEach(r => { %>
                <tr class="hover:bg-paper-2">
                  <td class="px-6 py-4 font-mono font-bold text-muted">#<%= r.id %></td>
                  <td class="px-6 py-4 font-bold text-ink uppercase"><%= r.kota_asal %></td>
                  <td class="px-6 py-4 font-bold text-ink uppercase"><%= r.kota_tujuan %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  <% } else if (tab === 'kendaraan') { %>
    <!-- Tab Kendaraan -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-4">
        <div class="transit-box p-6">
          <h2 class="text-xs font-extrabold uppercase tracking-wider text-ink border-b-bar border-rule pb-2 mb-2">Daftarkan Minibus Baru</h2>
          <p class="text-[11px] text-muted mb-4">Sistem secara otomatis akan membuat 5 kursi kabin standar (Kursi 1 s/d 5) untuk armada ini.</p>
          <form action="/admin/master/kendaraan" method="POST" class="space-y-4">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div>
              <label for="jenis" class="block text-xs font-bold uppercase text-ink mb-1.5">Jenis / Tipe Armada *</label>
              <input type="text" id="jenis" name="jenis" required placeholder="Contoh: Toyota HiAce Commuter" class="w-full border-bar border-rule bg-paper px-3 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent">
            </div>

            <div>
              <label for="nomor_polisi" class="block text-xs font-bold uppercase text-ink mb-1.5">Nomor Polisi (Plat) *</label>
              <input type="text" id="nomor_polisi" name="nomor_polisi" required placeholder="B 1234 XYZ" class="w-full border-bar border-rule bg-paper px-3 py-2 text-xs font-bold text-ink font-mono uppercase focus:outline-none focus:border-accent">
            </div>

            <div>
              <label for="warna" class="block text-xs font-bold uppercase text-ink mb-1.5">Warna Kendaraan</label>
              <input type="text" id="warna" name="warna" placeholder="Putih Metalik" class="w-full border-bar border-rule bg-paper px-3 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent">
            </div>

            <button type="submit" class="w-full transit-btn transit-btn-cobalt py-2.5 text-xs font-bold">
              Daftarkan Armada (5 Kursi)
            </button>
          </form>
        </div>
      </div>

      <div class="lg:col-span-8">
        <div class="transit-box overflow-hidden">
          <table class="min-w-full divide-y-bar divide-rule text-xs">
            <thead class="bg-paper-3 font-bold text-ink uppercase">
              <tr>
                <th class="px-6 py-3 text-left">ID</th>
                <th class="px-6 py-3 text-left">Plat Nomor</th>
                <th class="px-6 py-3 text-left">Tipe Minibus</th>
                <th class="px-6 py-3 text-left">Warna</th>
                <th class="px-6 py-3 text-center">Kapasitas</th>
              </tr>
            </thead>
            <tbody class="divide-y-hair divide-rule bg-paper">
              <% vehicles.forEach(v => { %>
                <tr class="hover:bg-paper-2">
                  <td class="px-6 py-4 font-mono font-bold text-muted">#<%= v.id %></td>
                  <td class="px-6 py-4 font-mono font-bold text-accent uppercase"><%= v.nomor_polisi %></td>
                  <td class="px-6 py-4 font-bold text-ink"><%= v.jenis %></td>
                  <td class="px-6 py-4 text-muted"><%= v.warna || '-' %></td>
                  <td class="px-6 py-4 text-center">
                    <span class="inline-block px-2.5 py-0.5 border-hair border-rule text-xs font-bold text-ink">
                      <%= v.kapasitas_kursi || 5 %> Kursi
                    </span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  <% } else if (tab === 'kota') { %>
    <!-- Tab Kota -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-4">
        <div class="transit-box p-6">
          <h2 class="text-xs font-extrabold uppercase tracking-wider text-ink border-b-bar border-rule pb-2 mb-4">Tambah Titik Kota</h2>
          <form action="/admin/master/kota" method="POST" class="space-y-4">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div>
              <label for="nama" class="block text-xs font-bold uppercase text-ink mb-1.5">Nama Kota / Terminal *</label>
              <input type="text" id="nama" name="nama" required placeholder="Contoh: Bandung" class="w-full border-bar border-rule bg-paper px-3 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent">
            </div>

            <button type="submit" class="w-full transit-btn transit-btn-cobalt py-2.5 text-xs font-bold">
              Simpan Kota Baru
            </button>
          </form>
        </div>
      </div>

      <div class="lg:col-span-8">
        <div class="transit-box overflow-hidden">
          <table class="min-w-full divide-y-bar divide-rule text-xs">
            <thead class="bg-paper-3 font-bold text-ink uppercase">
              <tr>
                <th class="px-6 py-3 text-left">ID</th>
                <th class="px-6 py-3 text-left">Nama Kota / Terminal</th>
              </tr>
            </thead>
            <tbody class="divide-y-hair divide-rule bg-paper">
              <% cities.forEach(c => { %>
                <tr class="hover:bg-paper-2">
                  <td class="px-6 py-4 font-mono font-bold text-muted">#<%= c.id %></td>
                  <td class="px-6 py-4 font-bold text-ink uppercase"><%= c.nama %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>
</div>
