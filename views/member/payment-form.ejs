<div class="max-w-2xl mx-auto space-y-6">
  <div class="transit-box p-6 sm:p-8">
    <div class="border-b-bar border-rule pb-5">
      <span class="text-xs font-bold text-accent uppercase tracking-wider block">Konfirmasi Pembayaran</span>
      <h1 class="text-xl font-extrabold text-ink uppercase tracking-tight mt-1">Unggah Bukti Transfer Bank</h1>
      <p class="text-xs text-muted mt-1">
        Kode Booking: <strong class="font-mono text-ink"><%= booking.kode_booking %></strong> &bull; Total: <strong class="text-ink num"><%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(booking.total_harga) %></strong>
      </p>
    </div>

    <form action="/pesanan/<%= booking.kode_booking %>/bayar?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data" class="mt-6 space-y-5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label for="referensi" class="block text-xs font-bold uppercase text-ink mb-1.5">Nomor Referensi / No. Transaksi Bank *</label>
        <input type="text" id="referensi" name="referensi" required class="w-full border-bar border-rule bg-paper px-3.5 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent" placeholder="Contoh: 2026103112345678">
      </div>

      <div>
        <label for="no_rek_pengirim" class="block text-xs font-bold uppercase text-ink mb-1.5">Nomor Rekening Pengirim *</label>
        <input type="text" id="no_rek_pengirim" name="no_rek_pengirim" required class="w-full border-bar border-rule bg-paper px-3.5 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent" placeholder="Contoh: BCA 1234567890 a.n Anda">
      </div>

      <div>
        <label for="bukti" class="block text-xs font-bold uppercase text-ink mb-1.5">Berkas Foto Resi Transfer *</label>
        <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-bar border-rule border-dashed bg-paper-3 hover:border-accent transition-colors">
          <div class="space-y-2 text-center">
            <div class="flex text-xs text-ink justify-center font-bold">
              <label for="bukti" class="cursor-pointer transit-btn transit-btn-ink py-1.5 px-3">
                <span>Pilih Berkas Resi</span>
                <input id="bukti" name="bukti" type="file" accept="image/jpeg,image/png,image/webp" required class="sr-only">
              </label>
            </div>
            <p class="text-[11px] text-muted">Format didukung: JPG, PNG, atau WebP (Maksimal 5MB)</p>
          </div>
        </div>
        <p id="file-chosen" class="mt-2 text-xs font-bold text-accent"></p>
      </div>

      <div class="pt-4 flex items-center justify-between gap-4 border-t-hair border-rule">
        <a href="/pesanan/<%= booking.kode_booking %>" class="transit-btn transit-btn-ink text-xs py-2.5 px-4">
          &larr; Detail Pesanan
        </a>
        <button type="submit" class="transit-btn transit-btn-cobalt text-xs py-2.5 px-6">
          Kirim Bukti Pembayaran
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  const fileInput = document.getElementById('bukti');
  const fileChosen = document.getElementById('file-chosen');
  if (fileInput && fileChosen) {
    fileInput.addEventListener('change', () => {
      if (fileInput.files.length > 0) {
        fileChosen.textContent = 'Berkas dipilih: ' + fileInput.files[0].name + ' (' + Math.round(fileInput.files[0].size / 1024) + ' KB)';
      }
    });
  }
</script>
