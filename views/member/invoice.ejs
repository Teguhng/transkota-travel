<div class="max-w-4xl mx-auto space-y-6">
  <!-- Status Banner & Timer: Wayfind Signage Plate -->
  <% if (booking.status === 'menunggu_pembayaran') { %>
    <div data-expires-at="<%= booking.jatuh_tempo ? (new Date(booking.jatuh_tempo)).toISOString() : (booking.batas_pembayaran ? (new Date(booking.batas_pembayaran)).toISOString() : '') %>" class="border-bar border-ink bg-accent-2 text-ink p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="w-8 h-8 transit-plate flex items-center justify-center font-extrabold text-sm flex-shrink-0">!</span>
        <div>
          <h3 class="text-xs font-extrabold uppercase tracking-tight">Selesaikan Pembayaran Kursi</h3>
          <p class="text-xs font-bold">Kursi ditahan atomik. Lakukan pembayaran sebelum hitungan mundur berakhir.</p>
        </div>
      </div>
      <div class="text-right flex items-center gap-2 sm:block">
        <span class="text-[11px] uppercase tracking-wider block font-bold text-ink">Batas Waktu:</span>
        <span class="countdown-display font-mono text-xl font-black text-ink">--:--</span>
      </div>
    </div>
  <% } else if (booking.status === 'lunas') { %>
    <div class="border-bar border-ink bg-paper-2 text-ink p-5 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="w-8 h-8 bg-ink text-paper flex items-center justify-center font-bold text-sm flex-shrink-0">&#10003;</span>
        <div>
          <h3 class="text-xs font-extrabold uppercase tracking-tight">Tiket Lunas & Terkonfirmasi</h3>
          <p class="text-xs text-muted">Pembayaran telah diverifikasi loket. Tiket resmi siap dicetak.</p>
        </div>
      </div>
      <a href="/pesanan/<%= booking.kode_booking %>/cetak" target="_blank" class="transit-btn transit-btn-cobalt text-xs py-2 px-4">
        Cetak E-Tiket
      </a>
    </div>
  <% } else if (booking.status === 'dibatalkan' || booking.status === 'kedaluwarsa' || booking.status === 'kadaluarsa') { %>
    <div class="border-bar border-[var(--color-error)] bg-paper-2 text-ink p-5 flex items-center gap-3">
      <span class="w-8 h-8 bg-[var(--color-error)] text-white flex items-center justify-center font-bold text-sm flex-shrink-0">&times;</span>
      <div>
        <h3 class="text-xs font-extrabold uppercase tracking-tight">Pesanan <%= booking.status.includes('k') ? 'Kedaluwarsa' : 'Dibatalkan' %></h3>
        <p class="text-xs text-muted">Kursi telah dilepaskan kembali ke publik.</p>
      </div>
    </div>
  <% } %>

  <!-- Kartu Utama Detail Faktur: Wayfind Reservation Voucher -->
  <div class="transit-box p-6 sm:p-8 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b-bar border-rule pb-6">
      <div>
        <span class="text-[11px] font-bold text-muted uppercase tracking-wider block">Kode Reservasi Resmi</span>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-wider font-mono"><%= booking.kode_booking %></h1>
        <span class="text-xs text-muted mt-1 block">Diterbitkan pada <%= new Date(booking.dibuat_pada || booking.created_at || Date.now()).toLocaleString('id-ID') %></span>
      </div>

      <div class="text-left sm:text-right">
        <span class="text-[11px] font-bold text-muted uppercase tracking-wider block">Status Reservasi</span>
        <span class="badge-status inline-block px-3 py-1 border-hair border-rule text-xs font-extrabold uppercase tracking-wider mt-1
          <%= booking.status === 'lunas' ? 'text-accent bg-paper' : '' %>
          <%= booking.status === 'menunggu_pembayaran' ? 'bg-accent-2 text-ink' : '' %>
          <%= booking.status === 'dibatalkan' || booking.status === 'kedaluwarsa' ? 'text-muted bg-paper-3' : '' %>">
          <%= booking.status.replace('_', ' ') %>
        </span>
      </div>
    </div>

    <!-- Info Perjalanan -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-paper-3 p-5 border-bar border-rule">
      <div>
        <h4 class="text-xs font-bold text-muted uppercase tracking-wider mb-2">Rute Perjalanan</h4>
        <div class="space-y-1">
          <p class="text-base font-extrabold text-ink uppercase"><%= booking.kota_asal %> &rarr; <%= booking.kota_tujuan %></p>
          <% const dep = new Date(booking.berangkat_pada); %>
          <p class="text-xs text-muted"><%= dep.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></p>
          <p class="text-xs font-bold text-accent">Pukul <%= dep.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %> WIB</p>
        </div>
      </div>

      <div>
        <h4 class="text-xs font-bold text-muted uppercase tracking-wider mb-2">Armada & Pemesan</h4>
        <div class="space-y-1 text-xs text-muted">
          <p>Armada: <strong class="text-ink"><%= booking.nama_kendaraan || booking.kendaraan_jenis || 'Minibus Eksekutif' %></strong></p>
          <p>Nomor Polisi: <strong class="text-ink font-mono"><%= booking.nomor_polisi %></strong></p>
          <p>Pemesan: <strong class="text-ink"><%= booking.nama_pemesan %> (<%= booking.telepon_pemesan %>)</strong></p>
        </div>
      </div>
    </div>

    <!-- Manifest Kursi & Penumpang: Departure Table -->
    <% 
      const passengerList = (booking.details && booking.details.length > 0) ? booking.details : (booking.penumpang || []); 
      const totalAmount = booking.total_harga || booking.total || 0;
    %>
    <div>
      <h3 class="text-xs font-extrabold text-ink uppercase tracking-wider mb-3">Manifest Kursi & Penumpang</h3>
      <div class="border-bar border-rule overflow-hidden">
        <table class="min-w-full divide-y-bar divide-rule text-xs">
          <thead class="bg-paper-3">
            <tr>
              <th class="px-4 py-3 text-left font-bold text-ink uppercase">Kursi</th>
              <th class="px-4 py-3 text-left font-bold text-ink uppercase">Nama Penumpang</th>
              <th class="px-4 py-3 text-left font-bold text-ink uppercase">Telepon</th>
              <th class="px-4 py-3 text-right font-bold text-ink uppercase">Tarif</th>
            </tr>
          </thead>
          <tbody class="divide-y-hair divide-rule bg-paper">
            <% passengerList.forEach(p => { %>
              <tr>
                <td class="px-4 py-3 font-bold text-accent font-mono">Kursi <%= p.nomor_kursi || p.nomor %></td>
                <td class="px-4 py-3 font-bold text-ink"><%= p.nama_penumpang || p.nama %></td>
                <td class="px-4 py-3 text-muted font-mono"><%= p.telepon_penumpang || p.telepon || '-' %></td>
                <td class="px-4 py-3 text-right font-extrabold text-ink num">
                  <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(p.harga || (totalAmount / (passengerList.length || 1))) %>
                </td>
              </tr>
            <% }) %>
          </tbody>
          <tfoot class="bg-paper-3 font-extrabold border-t-bar border-rule">
            <tr>
              <td colspan="3" class="px-4 py-3 text-right text-ink uppercase">Total Tagihan:</td>
              <td class="px-4 py-3 text-right text-base text-ink num">
                <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(totalAmount) %>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>

    <!-- Instruksi Pembayaran Bank -->
    <% if (booking.status === 'menunggu_pembayaran') { %>
      <div class="border-t-bar border-rule pt-6 space-y-4">
        <h4 class="text-xs font-extrabold uppercase text-ink">Instruksi Pembayaran Transfer Bank</h4>
        <div class="p-4 border-bar border-rule bg-paper-3 text-xs space-y-2">
          <p class="text-muted">Transfer tepat nominal <strong class="text-ink num"><%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(totalAmount) %></strong> ke rekening resmi travel:</p>
          <div class="bg-paper p-3 border-bar border-rule font-mono text-xs">
            <div>Bank: <strong class="text-ink">BCA (Bank Central Asia)</strong></div>
            <div>Nomor Rekening: <strong class="text-sm text-ink">8830-1928-3011</strong></div>
            <div>Atas Nama: <strong class="text-ink">PT TRAVEL NUSANTARA JAYA</strong></div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <a href="/pesanan/<%= booking.kode_booking %>/bayar" class="flex-1 transit-btn transit-btn-cobalt py-3 text-xs">
            Unggah Bukti Transfer Sekarang
          </a>
          
          <form action="/pesanan/<%= booking.kode_booking %>/batal" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin membatalkan pesanan ini?');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="alasan" value="Dibatalkan secara mandiri oleh pelanggan">
            <button type="submit" class="w-full sm:w-auto transit-btn transit-btn-ink py-3 px-4 text-xs">
              Batalkan Pesanan
            </button>
          </form>
        </div>
      </div>
    <% } %>

    <!-- Riwayat Pembayaran Jika Ada -->
    <% if (payment) { %>
      <div class="border-t-bar border-rule pt-6">
        <h4 class="text-xs font-extrabold text-ink uppercase mb-2">Riwayat Konfirmasi Pembayaran</h4>
        <div class="text-xs text-muted space-y-1">
          <p>Metode: <strong class="text-ink uppercase"><%= payment.metode %></strong></p>
          <p>Status: <strong class="text-ink uppercase"><%= payment.status %></strong></p>
          <% if (payment.referensi) { %><p>Referensi: <strong class="text-ink font-mono"><%= payment.referensi %></strong></p><% } %>
          <% if (payment.catatan_operator) { %><p class="text-accent-2 font-bold">Catatan Petugas: <%= payment.catatan_operator %></p><% } %>
        </div>
      </div>
    <% } %>
  </div>
</div>

<script src="/js/countdown.js"></script>
