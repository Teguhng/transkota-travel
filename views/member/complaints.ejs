<div class="space-y-8">
  <div class="transit-box p-6 sm:p-8">
    <div class="inline-block px-2.5 py-0.5 mb-2 border-hair border-rule text-xs font-bold uppercase text-accent bg-paper-3">
      Pusat Bantuan
    </div>
    <h1 class="text-xl sm:text-2xl font-extrabold text-ink uppercase tracking-tight">Layanan & Pengaduan Penumpang</h1>
    <p class="text-xs text-muted mt-1">Sampaikan kendala armada, keluhan supir, atau pertanyaan jadwal kepada tim operasional loket kami.</p>

    <!-- Formulir Keluhan Baru -->
    <form action="/member/keluhan" method="POST" class="mt-6 space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label for="id_pemesanan" class="block text-xs font-bold uppercase text-ink mb-1.5">Terkait Tiket Perjalanan (Opsional)</label>
        <select id="id_pemesanan" name="id_pemesanan" class="w-full border-bar border-rule bg-paper px-3 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent">
          <option value="">-- Tidak Terkait Tiket Tertentu --</option>
          <% bookings.forEach(b => { %>
            <option value="<%= b.id %>"><%= b.kode_booking %> (<%= b.kota_asal %> &rarr; <%= b.kota_tujuan %>)</option>
          <% }) %>
        </select>
      </div>

      <div>
        <label for="judul" class="block text-xs font-bold uppercase text-ink mb-1.5">Topik Pengaduan *</label>
        <input type="text" id="judul" name="judul" required placeholder="Contoh: Keterlambatan armada / Pelayanan supir" class="w-full border-bar border-rule bg-paper px-3.5 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent">
      </div>

      <div>
        <label for="isi" class="block text-xs font-bold uppercase text-ink mb-1.5">Rincian Lengkap Pengaduan *</label>
        <textarea id="isi" name="isi" rows="4" required placeholder="Jelaskan kronologi kejadian..." class="w-full border-bar border-rule bg-paper px-3.5 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent"></textarea>
      </div>

      <div class="pt-2">
        <button type="submit" class="transit-btn transit-btn-cobalt py-3 px-6 text-xs font-bold">
          Kirim Pengaduan
        </button>
      </div>
    </form>
  </div>

  <!-- Riwayat Pengaduan -->
  <div class="space-y-4">
    <div class="flex items-center justify-between pb-2 border-b-bar border-rule">
      <h2 class="text-base font-extrabold text-ink uppercase tracking-tight">Riwayat Pengaduan Anda (<%= complaints.length %>)</h2>
      <span class="text-xs text-muted uppercase font-bold">Evaluasi Layanan</span>
    </div>

    <% if (complaints.length === 0) { %>
      <div class="text-center py-12 transit-box text-xs font-bold uppercase text-muted">
        Belum ada riwayat pengaduan yang dikirimkan.
      </div>
    <% } else { %>
      <div class="space-y-4">
        <% complaints.forEach(c => { %>
          <div class="transit-box p-6 space-y-3">
            <div class="flex items-center justify-between border-b-hair border-rule pb-2">
              <h3 class="text-xs font-extrabold text-ink uppercase"><%= c.judul %></h3>
              <span class="px-2 py-0.5 border-hair border-rule text-[10px] font-extrabold uppercase
                <%= c.status === 'selesai' ? 'text-accent bg-paper-3' : '' %>
                <%= c.status === 'diproses' ? 'bg-ink text-paper' : '' %>
                <%= c.status === 'baru' || c.status === 'diajukan' ? 'bg-accent-2 text-ink' : '' %>">
                <%= c.status %>
              </span>
            </div>

            <p class="text-xs text-ink bg-paper-3 p-3 border-hair border-rule"><%= c.isi %></p>

            <% if (c.tanggapan) { %>
              <div class="text-xs p-3 border-bar border-accent bg-paper space-y-1">
                <span class="font-extrabold text-accent uppercase block">Tanggapan Petugas:</span>
                <p class="text-ink"><%= c.tanggapan %></p>
                <% if (c.selesai_pada) { %>
                  <span class="text-[10px] text-muted block mt-1">Ditanggapi pada: <%= new Date(c.selesai_pada).toLocaleString('id-ID') %></span>
                <% } %>
              </div>
            <% } %>

            <div class="text-[11px] text-muted pt-1">
              Dikirim pada: <%= new Date(c.dibuat_pada || c.created_at).toLocaleString('id-ID') %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>
