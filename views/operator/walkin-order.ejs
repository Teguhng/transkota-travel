<div class="space-y-8">
  <div class="border-b-bar border-rule pb-4">
    <div class="inline-block px-2.5 py-0.5 mb-2 border-hair border-rule text-xs font-bold uppercase text-accent bg-paper-3">
      Loket Fisik Terminal
    </div>
    <h1 class="text-xl sm:text-2xl font-extrabold text-ink uppercase tracking-tight">Kasir Walk-in (Pelunasan Tunai)</h1>
    <p class="text-xs text-muted mt-1">Penerbitan tiket langsung di loket fisik dengan transaksi pelunasan tunai instan.</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Kolom Pemilihan Jadwal & Formulir -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Pilihan Jadwal Keberangkatan -->
      <div class="transit-box p-6">
        <label for="jadwal-selector" class="block text-xs font-bold uppercase text-ink mb-2">Pilih Jadwal Keberangkatan Minibus</label>
        <select id="jadwal-selector" onchange="window.location.href='/operator/walkin?jadwal=' + this.value" class="w-full border-bar border-rule bg-paper px-3.5 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent">
          <% schedules.forEach(s => { 
               const d = new Date(s.berangkat_pada);
               const isSel = selectedJadwalId == s.id;
          %>
            <option value="<%= s.id %>" <%= isSel ? 'selected' : '' %>>
              <%= s.kota_asal %> &rarr; <%= s.kota_tujuan %> | <%= d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' }) %> <%= d.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %> WIB (<%= s.kursi_tersedia %> kursi) - <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(s.harga) %>
            </option>
          <% }) %>
        </select>
      </div>

      <% if (selectedSchedule) { %>
        <!-- Formulir Data Penumpang & Pemilihan Kursi -->
        <div class="transit-box p-6">
          <form action="/operator/walkin/proses" method="POST" class="space-y-4">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="jadwal_id" value="<%= selectedSchedule.id %>">

            <div>
              <label class="block text-xs font-bold uppercase text-ink mb-2">Pilih Nomor Kursi Kabin *</label>
              <div class="grid grid-cols-5 gap-3">
                <% seats.forEach(st => { 
                     const isAvail = st.status === 'tersedia';
                %>
                  <label class="relative flex flex-col items-center justify-center p-3 border-bar text-center cursor-pointer transition-colors
                    <%= isAvail ? 'border-rule bg-paper hover:border-accent' : 'border-rule bg-paper-3 opacity-40 cursor-not-allowed' %>">
                    <input type="radio" name="kursi_id" value="<%= st.id %>" <%= !isAvail ? 'disabled' : '' %> required class="sr-only peer">
                    <span class="text-base font-extrabold peer-checked:text-accent">Kursi <%= st.nomor %></span>
                    <span class="text-[10px] uppercase font-bold <%= isAvail ? 'text-ink' : 'text-muted' %>"><%= st.status %></span>
                    <div class="absolute inset-0 border-bar border-transparent peer-checked:border-accent pointer-events-none"></div>
                  </label>
                <% }) %>
              </div>
            </div>

            <div class="pt-2">
              <label for="nama" class="block text-xs font-bold uppercase text-ink mb-1.5">Nama Lengkap Penumpang *</label>
              <input type="text" id="nama" name="nama" required placeholder="Sesuai KTP / SIM" class="w-full border-bar border-rule bg-paper px-3.5 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent">
            </div>

            <div>
              <label for="telepon" class="block text-xs font-bold uppercase text-ink mb-1.5">Nomor Telepon / WhatsApp *</label>
              <input type="tel" id="telepon" name="telepon" required placeholder="08xxxxxxxxxx" class="w-full border-bar border-rule bg-paper px-3.5 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent">
            </div>

            <div class="pt-4 border-t-bar border-rule flex items-center justify-between">
              <div>
                <span class="text-[11px] text-muted uppercase font-bold block">Total Bayar Tunai:</span>
                <span class="text-xl font-extrabold text-ink num">
                  <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(selectedSchedule.harga) %>
                </span>
              </div>
              <button type="submit" class="transit-btn transit-btn-cobalt py-3 px-6 text-xs">
                Terima Tunai & Terbitkan Tiket
              </button>
            </div>
          </form>
        </div>
      <% } %>
    </div>

    <!-- Kolom Ringkasan Jadwal Terpilih -->
    <div class="lg:col-span-5">
      <% if (selectedSchedule) { %>
        <div class="transit-box p-6 space-y-4">
          <h2 class="text-xs font-extrabold uppercase tracking-wider text-muted border-b-bar border-rule pb-2">Ringkasan Jadwal Minibus</h2>
          
          <div class="space-y-2 text-xs">
            <div>
              <span class="text-muted uppercase font-bold block">Rute Perjalanan</span>
              <span class="text-base font-extrabold text-ink uppercase"><%= selectedSchedule.kota_asal %> &rarr; <%= selectedSchedule.kota_tujuan %></span>
            </div>
            <div>
              <span class="text-muted uppercase font-bold block">Waktu Keberangkatan</span>
              <% const dep = new Date(selectedSchedule.berangkat_pada); %>
              <span class="font-bold text-ink"><%= dep.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></span>
              <span class="font-bold text-accent block"><%= dep.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %> WIB</span>
            </div>
            <div>
              <span class="text-muted uppercase font-bold block">Armada Minibus</span>
              <span class="font-bold text-ink"><%= selectedSchedule.kendaraan_jenis || 'Minibus Eksekutif' %> (<%= selectedSchedule.nomor_polisi %>)</span>
            </div>
            <div>
              <span class="text-muted uppercase font-bold block">Tarif Tunai Loket</span>
              <span class="text-base font-extrabold text-ink num">
                <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(selectedSchedule.harga) %>
              </span>
            </div>
          </div>

          <div class="p-3 border-hair border-rule bg-paper-3 text-xs text-muted">
            Pemesanan kasir walk-in secara otomatis mengaitkan akun pelanggan jika nomor telepon telah terdaftar, atau mendaftarkan profil member walk-in otomatis.
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>
